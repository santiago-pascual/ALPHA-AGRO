{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quant Alpha Agro forecast v1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "issue_time",
    "target_month",
    "horizon_months",
    "scope",
    "target",
    "model",
    "input_observation_cutoff",
    "availability",
    "value",
    "units",
    "predictive_interval",
    "calibration",
    "quality_flags",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "forecast_v1"
    },
    "status": {
      "enum": [
        "retrospective_simulation",
        "experimental",
        "operationally_eligible"
      ]
    },
    "issue_time": {
      "type": "string",
      "format": "date-time"
    },
    "target_month": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "horizon_months": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "id",
        "bounds_west_south_east_north"
      ]
    },
    "target": {
      "enum": [
        "storage",
        "anomaly",
        "low_moisture"
      ]
    },
    "model": {
      "type": "object",
      "required": [
        "name",
        "version"
      ]
    },
    "input_observation_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "availability": {
      "type": "object",
      "required": [
        "policy",
        "publication_evidence",
        "operationally_eligible",
        "input_months"
      ],
      "properties": {
        "operationally_eligible": {
          "type": "boolean"
        },
        "input_months": {
          "type": "array",
          "minItems": 1
        },
        "publication_evidence": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "value": {
      "type": "number"
    },
    "units": {
      "enum": [
        "mm",
        "probability"
      ]
    },
    "predictive_interval": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "level",
        "lower",
        "upper",
        "method"
      ],
      "properties": {
        "level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        },
        "method": {
          "type": "string"
        }
      }
    },
    "calibration": {
      "type": "object",
      "required": [
        "start",
        "end",
        "n_months",
        "labels_available_by",
        "metrics"
      ]
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "collection",
        "doi",
        "input_panel_sha256"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "target": {
            "const": "low_moisture"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "minimum": 0,
            "maximum": 1
          },
          "units": {
            "const": "probability"
          },
          "predictive_interval": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "units": {
            "const": "mm"
          },
          "predictive_interval": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "operationally_eligible"
          }
        }
      },
      "then": {
        "properties": {
          "availability": {
            "properties": {
              "operationally_eligible": {
                "const": true
              },
              "publication_evidence": {
                "type": "object",
                "minProperties": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "availability": {
            "properties": {
              "operationally_eligible": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
